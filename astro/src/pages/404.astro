---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFoundContent from '@app/islands/NotFoundContent';

Astro.response.status = 404;
---

<BaseLayout
  title="Page Not Found · PFControl"
  description="The page you're looking for doesn't exist or may have been removed."
  noindex={true}
>
  <NotFoundContent pathname={Astro.url.pathname} />
</BaseLayout>
